# =============================================================================
# FORJA · ARKA Fitness AI — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env.local en tu computador y pega estas mismas
# variables en Vercel -> Project Settings -> Environment Variables
# =============================================================================

# 1. URL pública de tu aplicación (en producción cambia por tu dominio de Vercel o propio)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. SUPABASE — Base de datos PostgreSQL + Autenticación + Códigos de Cortesía
# Se obtienen en Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETO CRÍTICO DE SERVIDOR (NUNCA poner NEXT_PUBLIC_ adelante):
SUPABASE_SERVICE_ROLE_KEY=

# Correo del administrador principal (tú) para habilitar el panel /admin automáticamente:
FORJA_ADMIN_EMAIL=

# 3. COACH IA + VISIÓN (Solo servidor — jamás sale al navegador)
# Crea una clave gratis o de pago en https://openrouter.ai/keys
COACH_API_KEY=
COACH_BASE_URL=https://openrouter.ai/api/v1
COACH_MODEL=qwen/qwen2.5-vl-72b-instruct:free
